# Servidor
PORT=4500
NODE_ENV=development
# Não usar o nome BASE_URL — Vite/Vitest reserva esse nome e injeta seu próprio valor.
APP_BASE_URL=http://localhost:4500

# Banco de dados
DATABASE_URL="postgresql://lojapix:lojapix@localhost:5435/lojapix"

# JWT (RS256) — gere com: npm run keys:generate (na raiz do monorepo)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Pagamento — "stub" gera Pix estático offline (funciona sem conta nenhuma, mas exige
# confirmação manual no painel); "mercadopago" cria cobrança Pix dinâmica de verdade.
PAYMENT_PROVIDER=stub
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=

# Usados pelo provider "stub" pra montar o BR Code (Pix copia-e-cola) offline
PIX_STATIC_KEY=00000000000
PIX_MERCHANT_NAME=LOJAPIX DEMO
PIX_MERCHANT_CITY=SAO PAULO
